# --- Variáveis do Data Lake (S3/MinIO) ---
# STORAGE_BACKEND: S3 para MinIO/SeaweedFS; LOCAL para espelho em disco
STORAGE_BACKEND=S3
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_BRONZE=bronze
S3_BUCKET_SILVER=silver
S3_BUCKET_GOLD=gold
# Raiz local do Data Lake quando STORAGE_BACKEND=LOCAL
DATA_LAKE_DIR=data/lake

# --- Data Warehouse (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg2://huol:huol_secret@localhost:5432/huol_dw

# --- Dashboard ---
DASHBOARD_TITLE=HUOL/UFRN — BI de Internações Hospitalares

# --- NLP / Instagram Graph API ---
# Preencha somente com credenciais obtidas no Meta for Developers.
# NUNCA versionar o .env com tokens reais.
IG_ACCESS_TOKEN=
IG_USER_ID=
IG_API_VERSION=v21.0
SENTIMENT_MODEL=cardiffnlp/twitter-xlm-roberta-base-sentiment
NLP_COMMENTS_INPUT=data/nlp/comentarios_huol.csv

# --- Execução local (sandbox) ---
LOCAL_S3_ENDPOINT=http://localhost:8333
